DATABASE_URL=postgresql://user:password@localhost:5432/zep
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Optional. The account with this email is promoted to ADMIN on sign-in.
ADMIN_EMAIL=

# Required for live assistant replies. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
